---
import Base from "../layouts/Base.astro";
import Command from "../components/Command.astro";
import { t, type Locale } from "../i18n";
import { REPO_URL, AGENT_IMAGE } from "../data/releases";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const dict = t(locale);

const toc = [
  { id: "start", label: dict.guide.startTitle },
  { id: "snapshots", label: dict.guide.snapTitle },
  { id: "browse", label: dict.guide.browseTitle },
  { id: "agent", label: dict.guide.agentTitle },
  { id: "remote", label: dict.guide.remoteTitle },
  { id: "size", label: dict.guide.sizeTitle },
  { id: "reference", label: dict.guide.refTitle },
  { id: "storage", label: dict.guide.storageTitle },
  { id: "limits", label: dict.guide.limitsTitle },
];

const agentConfig = `db = "/var/lib/spacetrace/snapshots.sqlite"
utc_offset_minutes = 0

[server]
listen = "127.0.0.1:7878"
token_file = "/etc/spacetrace/token"

[[roots]]
path = "/var"
schedule = "0 3 * * *"
label = "nightly"
exclude = ["node_modules", ".git"]
one_file_system = true
keep = 14`;

const checkOutput = `config       ok
database     /var/lib/spacetrace/snapshots.sqlite
host         nas
listen       127.0.0.1:7878
token        configured
ad-hoc scans refused

ROOT                          SCHEDULE        NEXT RUN
/var                          0 3 * * *       2026-09-09 03:00

Times are UTC.`;

const commands = [
  { name: "spacetrace scan PATH", body: "--save, --label" },
  { name: "spacetrace scans", body: "—" },
  { name: "spacetrace diff", body: "--path, --since-last, ID ID" },
  { name: "spacetrace ls PATH", body: "--top, --scan, --subpath" },
  { name: "spacetrace export", body: "--scan, --out" },
  { name: "spacetrace pull --root PATH", body: "--remote" },
  { name: "spacetrace prune / rm", body: "--keep, ID" },
  { name: "spacetrace-agent init", body: "—" },
  { name: "spacetrace-agent check", body: "—" },
  { name: "spacetrace-agent serve", body: "—" },
  { name: "spacetrace-agent push URL", body: "--root, --token" },
];

const options = [
  "--exclude NAME",
  "-x, --one-file-system",
  "--depth N",
  "--min SIZE",
  "--files",
  "--no-dedupe",
  "--json",
  "--db PATH",
  "--remote NAME|URL",
];
---

<Base
  locale={locale}
  page="guide"
  title={dict.guide.title}
  description={dict.guide.description}
>
  <div class="wrap doc">
    <nav class="toc" aria-label={dict.guide.onThisPage}>
      <p class="toc-title">{dict.guide.onThisPage}</p>
      <ol>
        {
          toc.map((item) => (
            <li>
              <a href={`#${item.id}`}>{item.label}</a>
            </li>
          ))
        }
      </ol>
    </nav>

    <div class="body">
      <header class="intro">
        <h1>{dict.guide.headline}</h1>
        <p class="lede">{dict.guide.lede}</p>
      </header>

      <section id="start">
        <h2>{dict.guide.startTitle}</h2>
        <p>{dict.guide.startBody}</p>
        <pre translate="no">$ <b>spacetrace scan ~/projects</b>
<span class="out">scanned 84,213 entries in 1.9s
total 12.4 GiB logical · 12.7 GiB on disk
3 paths could not be read</span></pre>
        <p>{dict.guide.startUnreadable}</p>

        <h3>{dict.guide.startNarrowTitle}</h3>
        <pre translate="no">spacetrace scan / <i>-x</i>
spacetrace scan ~/code <i>--exclude node_modules --exclude .git</i>
spacetrace scan /var <i>--depth 3</i>
spacetrace scan /srv <i>--no-dedupe</i></pre>
        <p>{dict.guide.startExclude}</p>
      </section>

      <section id="snapshots">
        <h2>{dict.guide.snapTitle}</h2>
        <p>{dict.guide.snapBody}</p>
        <pre translate="no">$ <b>spacetrace scan /srv --save --label weekly</b>
<span class="out">saved snapshot #1</span>

$ <b>spacetrace scans</b>
<span class="out"> ID  WHEN              HOST     ROOT   LABEL    TOTAL
  2  2026-09-06 19:40  srv-01   /srv            76.3 MiB
  1  2026-09-06 17:23  srv-01   /srv   weekly   23.8 MiB</span></pre>
        <p>{dict.guide.snapThen}</p>
        <pre translate="no">$ <b>spacetrace diff --path /srv</b>
<span class="out">#1 2026-09-06 17:23 [weekly]  →  #2 2026-09-06 19:40
total 23.8 MiB → 76.3 MiB   (+52.5 MiB)

      CHANGE  STATUS          NEW  PATH
   +40.1 MiB  grew       42.9 MiB  app/logs/
   +14.3 MiB  grew       25.7 MiB  backups/
    -1.9 MiB  removed         0 B  uploads/</span></pre>

        <div class="note">
          <span class="note-title">{dict.guide.culpritTitle}</span>
          <p>{dict.guide.culpritBody}</p>
        </div>

        <h3>{dict.guide.snapSinceTitle}</h3>
        <p>{dict.guide.snapSinceBody}</p>
        <Command locale={locale} command="spacetrace diff --since-last /srv" />

        <h3>{dict.guide.snapFilterTitle}</h3>
        <pre translate="no">spacetrace diff --path /srv <i>--min 10M</i>
spacetrace diff --path /srv <i>--files</i>
spacetrace diff 3 7</pre>

        <h3>{dict.guide.snapPruneTitle}</h3>
        <pre translate="no">spacetrace prune --path /srv --keep 30
spacetrace rm 4</pre>
      </section>

      <section id="browse">
        <h2>{dict.guide.browseTitle}</h2>
        <p>{dict.guide.browseBody}</p>
        <pre translate="no">spacetrace ls /var/lib --top 20
spacetrace ls --scan 3 --subpath docker/overlay2</pre>
        <p>{dict.guide.browseExport}</p>
        <Command
          locale={locale}
          command="spacetrace export --scan 3 --out scan.json && ncdu -f scan.json"
        />
        <p class="spaced">{dict.guide.browseJson}</p>
      </section>

      <section id="agent">
        <h2>{dict.guide.agentTitle}</h2>
        <p>{dict.guide.agentBody}</p>

        <ol class="steps">
          <li>
            <h4>{dict.guide.agentStep1}</h4>
            <Command
              locale={locale}
              command="spacetrace-agent init > /etc/spacetrace/agent.toml"
            />
            <Command
              locale={locale}
              command="head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n' > /etc/spacetrace/token && chmod 600 /etc/spacetrace/token"
            />
            <p>{dict.guide.agentStep1Body}</p>
          </li>
          <li>
            <h4>{dict.guide.agentStep2}</h4>
            <pre translate="no">{agentConfig}</pre>
            <p>{dict.guide.agentStep2Body}</p>
          </li>
          <li>
            <h4>{dict.guide.agentStep3}</h4>
            <pre translate="no">$ <b>spacetrace-agent --config /etc/spacetrace/agent.toml check</b>
<span class="out">{checkOutput}</span></pre>
            <p>{dict.guide.agentStep3Body}</p>
          </li>
          <li>
            <h4>{dict.guide.agentStep4}</h4>
            <Command locale={locale} command="systemctl enable --now spacetrace-agent" />
            <p>{dict.guide.agentStep4Body}</p>
            <p>{dict.guide.agentDocker}</p>
            <pre translate="no">{`docker run -d --name spacetrace \\
  -v /:/host:ro \\
  -v spacetrace-data:/var/lib/spacetrace \\
  -v /etc/spacetrace:/etc/spacetrace:ro \\
  -p 7878:7878 \\
  ${AGENT_IMAGE}`}</pre>
          </li>
        </ol>

        <h3>{dict.guide.agentSecTitle}</h3>
        <ul>
          {dict.guide.agentSec.map((item) => <li>{item}</li>)}
        </ul>
      </section>

      <section id="remote">
        <h2>{dict.guide.remoteTitle}</h2>
        <p>{dict.guide.remoteBody}</p>
        <pre translate="no">export SPACETRACE_TOKEN=…

spacetrace --remote https://nas.example.com scans
spacetrace --remote https://nas.example.com diff --path /var
spacetrace --remote https://nas.example.com ls --top 20
spacetrace --remote https://nas.example.com pull --root /var</pre>
        <p>{dict.guide.remoteSaveBody}</p>
        <pre translate="no">[remotes.nas]
url = "https://nas.example.com"
token = "…"</pre>

        <div class="note">
          <span class="note-title">{dict.guide.remoteNotDifferentTitle}</span>
          <p>{dict.guide.remoteNotDifferentBody}</p>
          <pre translate="no">curl -H "Authorization: Bearer $SPACETRACE_TOKEN" \
  https://nas.example.com/scans/7/download -o snap.sqlite
spacetrace --db snap.sqlite scans</pre>
        </div>
        <p>{dict.guide.remoteRefuse}</p>
      </section>

      <section id="size">
        <h2>{dict.guide.sizeTitle}</h2>
        <p>{dict.guide.sizeBody}</p>
        <div class="scroll-x">
          <table class="data">
            <thead>
              <tr>
                <th scope="col">{dict.guide.sizeMeasure}</th>
                <th scope="col">{dict.guide.sizeWhat}</th>
                <th scope="col">{dict.guide.sizeMatches}</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <th scope="row" class="mono">{dict.guide.sizeLogical}</th>
                <td>{dict.guide.sizeLogicalWhat}</td>
                <td class="mono" translate="no">du -sb</td>
              </tr>
              <tr>
                <th scope="row" class="mono">{dict.guide.sizeOnDisk}</th>
                <td>{dict.guide.sizeOnDiskWhat}</td>
                <td class="mono" translate="no">du -s --block-size=1</td>
              </tr>
              <tr>
                <th scope="row" class="mono">{dict.guide.sizeCapacity}</th>
                <td>{dict.guide.sizeCapacityWhat}</td>
                <td>{dict.guide.sizeCapacityMatches}</td>
              </tr>
            </tbody>
          </table>
        </div>
        <p class="spaced">{dict.guide.sizeDiverge}</p>
        <p>{dict.guide.sizeWhyOnDisk}</p>
        <p>{dict.guide.sizeCapacityWhy}</p>
        <p>{dict.guide.sizeLinks}</p>
      </section>

      <section id="reference">
        <h2>{dict.guide.refTitle}</h2>
        <dl class="ref">
          {
            commands.map((command) => (
              <>
                <dt translate="no">{command.name}</dt>
                <dd class="mono faint" translate="no">{command.body}</dd>
              </>
            ))
          }
        </dl>

        <h3>{dict.guide.refOptionsTitle}</h3>
        <ul class="opts" translate="no">
          {options.map((option) => <li>{option}</li>)}
        </ul>
      </section>

      <section id="storage">
        <h2>{dict.guide.storageTitle}</h2>
        <div class="scroll-x">
          <table class="data">
            <thead>
              <tr>
                <th scope="col">{dict.guide.storagePlatform}</th>
                <th scope="col">{dict.guide.storageDb}</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <th scope="row">macOS</th>
                <td class="mono" translate="no">
                  ~/Library/Application Support/spacetrace/
                </td>
              </tr>
              <tr>
                <th scope="row">Linux</th>
                <td class="mono" translate="no">$XDG_DATA_HOME/spacetrace/</td>
              </tr>
              <tr>
                <th scope="row">{dict.guide.storageAnywhere}</th>
                <td>{dict.guide.storageOverride}</td>
              </tr>
            </tbody>
          </table>
        </div>
        <p class="spaced">{dict.guide.storageShared}</p>
      </section>

      <section id="limits">
        <h2>{dict.guide.limitsTitle}</h2>
        <p>{dict.guide.limitsLede}</p>
        <ul>
          {dict.guide.limits.map((limit) => <li>{limit}</li>)}
        </ul>
        <p>
          <a href={`${REPO_URL}/blob/main/docs/AGENT.md`}>docs/AGENT.md</a>
        </p>
      </section>
    </div>
  </div>
</Base>

<style>
  .doc {
    display: grid;
    grid-template-columns: 216px minmax(0, 1fr);
    gap: clamp(28px, 5vw, 56px);
    padding-block: 44px 96px;
    align-items: start;
  }

  .toc {
    position: sticky;
    top: 84px;
    align-self: start;
    font-size: 0.92rem;
  }

  .toc-title {
    font-family: var(--cond);
    font-weight: 600;
    color: var(--faint);
    margin: 0 0 10px;
    font-size: 0.9rem;
  }

  .toc ol {
    list-style: none;
    padding: 0;
    margin: 0;
    border-left: 1px solid var(--line);
  }

  .toc li {
    margin: 0;
  }

  .toc a {
    display: block;
    padding: 5px 0 5px 14px;
    color: var(--dim);
    text-decoration: none;
    border-left: 1px solid transparent;
    margin-left: -1px;
  }

  .toc a:hover {
    color: #fff;
  }

  .toc a.active {
    color: #fff;
    border-left-color: var(--accent);
  }

  .intro {
    padding-bottom: 40px;
  }

  .intro h1 {
    margin-bottom: 14px;
  }

  section {
    padding-bottom: 48px;
  }

  section + section {
    border-top: 1px solid var(--line);
    padding-top: 42px;
  }

  h2 {
    margin-bottom: 16px;
  }

  h3 {
    margin: 30px 0 10px;
  }

  pre {
    white-space: pre;
  }

  .spaced {
    margin-top: 1.05em;
  }

  .opts {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    max-width: none;
  }

  .opts li {
    margin: 0;
    font-family: var(--mono);
    font-size: 0.82rem;
    color: var(--dim);
    background: var(--panel-raised);
    border: 1px solid var(--line);
    border-radius: var(--r-chip);
    padding: 4px 8px;
  }

  @media (max-width: 900px) {
    .doc {
      grid-template-columns: minmax(0, 1fr);
    }

    .toc {
      position: static;
      border-bottom: 1px solid var(--line);
      padding-bottom: 18px;
    }

    .toc ol {
      display: flex;
      flex-wrap: wrap;
      gap: 4px 18px;
      border-left: 0;
    }

    .toc a {
      padding: 2px 0;
      border-left: 0;
    }
  }
</style>

<script>
  // The contents list follows the reader. Purely additive: with no observer the
  // links are still links.
  const toc = document.querySelector("nav.toc");
  if (toc && "IntersectionObserver" in window) {
    const links = new Map<string, HTMLAnchorElement>();
    for (const link of toc.querySelectorAll<HTMLAnchorElement>('a[href^="#"]')) {
      links.set(link.getAttribute("href")!.slice(1), link);
    }

    const seen = new Map<string, boolean>();
    const sections = [...links.keys()]
      .map((id) => document.getElementById(id))
      .filter((el): el is HTMLElement => el !== null);

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) seen.set(entry.target.id, entry.isIntersecting);
        const current = sections.find((section) => seen.get(section.id))?.id;
        for (const [id, link] of links) link.classList.toggle("active", id === current);
      },
      { rootMargin: "-88px 0px -68% 0px", threshold: 0.01 },
    );

    for (const section of sections) observer.observe(section);
  }
</script>
