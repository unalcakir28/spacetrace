---
import Base from "../layouts/Base.astro";
import Command from "../components/Command.astro";
import DiffTerminal from "../components/DiffTerminal.astro";
import Treemap from "../components/demo/Treemap.tsx";
import { t, type Locale } from "../i18n";
import { localeUrl } from "../i18n/routing";
import { INSTALL_COMMAND, REPO_URL } from "../data/releases";
import ReleaseScript from "../components/ReleaseScript.astro";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const dict = t(locale);

const parts = [
  {
    name: dict.parts.desktopName,
    role: dict.parts.desktopRole,
    pitch: dict.parts.desktopPitch,
    points: dict.parts.desktopPoints,
    cta: dict.parts.desktopCta,
    href: localeUrl(locale, "desktop"),
    licence: dict.common.proprietary,
    lead: true,
  },
  {
    name: dict.parts.cliName,
    role: dict.parts.cliRole,
    pitch: dict.parts.cliPitch,
    points: dict.parts.cliPoints,
    cta: dict.parts.cliCta,
    href: localeUrl(locale, "cli"),
    licence: dict.common.apacheCore,
  },
  {
    name: dict.parts.hubName,
    role: dict.parts.hubRole,
    pitch: dict.parts.hubPitch,
    points: dict.parts.hubPoints,
    cta: dict.parts.hubCta,
    href: localeUrl(locale, "hub"),
    licence: dict.common.proprietary,
  },
];

const claims = [
  { title: dict.trust.duTitle, body: dict.trust.duBody },
  { title: dict.trust.capacityTitle, body: dict.trust.capacityBody },
  { title: dict.trust.forecastTitle, body: dict.trust.forecastBody },
  { title: dict.trust.snapshotTitle, body: dict.trust.snapshotBody },
  { title: dict.trust.errorsTitle, body: dict.trust.errorsBody },
  { title: dict.trust.deleteTitle, body: dict.trust.deleteBody },
];
---

<Base
  locale={locale}
  page=""
  title={dict.home.title}
  description={dict.home.description}
>
  <section class="wrap hero">
    <p class="kicker">{dict.home.kicker}</p>
    <h1>
      <span class="given">{dict.home.headlineGiven}</span>
      <span class="second">{dict.home.headlineSecond}</span>
    </h1>
    <p class="lede">{dict.home.lede}</p>

    <div class="row hero-actions">
      <a
        class="btn btn-primary btn-lg"
        href={localeUrl(locale, "download")}
        data-hero-dl="desktop"
        data-match-macos="macos-universal.dmg"
        data-match-windows="windows-x86_64-setup.exe"
        data-match-linux="linux-x86_64.deb"
      >
        <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path
            d="M8 1.5v9m0 0L4.5 7M8 10.5 11.5 7M2 13.5h12"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"></path>
        </svg>
        {dict.home.ctaPrimary}
      </a>
      <span class="faint mono meta">
        <span data-size></span>
        <span data-version="desktop">{dict.common.latestBuild}</span>
      </span>
      <a class="btn" href={localeUrl(locale, "cli")}>
        {dict.home.ctaSecondary}
      </a>
    </div>
    <p class="faint small">{dict.home.noAccount}</p>
  </section>

  <!-- The map is the hero's second half, not a section further down: it is the
       product's own artefact, and it earns the space above the fold. -->
  <section class="wrap demo-band" aria-labelledby="demo-title">
    <div class="demo-head">
      <h2 id="demo-title">{dict.home.demoTitle}</h2>
    </div>
    <!-- client:load, not client:visible: the map is in the hero, so it is
         already on screen and "wait until it scrolls into view" would only
         delay the one thing a visitor is meant to touch. -->
    <Treemap
      client:load
      locale={locale}
      labels={{
        zoomHint: dict.demo.zoomHint,
        tapHint: dict.demo.tapHint,
        backHint: dict.demo.backHint,
        rootLabel: dict.demo.rootLabel,
        basisLabel: dict.demo.basisLabel,
        onDisk: dict.demo.onDisk,
        logical: dict.demo.logical,
        basisHelp: dict.demo.basisHelp,
        sparseCallout: dict.demo.sparseCallout,
        selected: dict.demo.selected,
        share: dict.demo.share,
        kind: dict.demo.kind,
        sparse: dict.demo.sparse,
        empty: dict.demo.empty,
        emptyHelp: dict.demo.emptyHelp,
        entries: dict.demo.entries,
        categories: dict.categories,
      }}
    />
    <p class="faint demo-cap">{dict.home.demoLede}</p>
  </section>

  <section class="band">
    <div class="wrap">
      <div class="split aside">
        <div data-reveal>
          <h2>{dict.home.diffTitle}</h2>
          <p class="dim">{dict.home.diffLede}</p>
        </div>
        <div data-reveal data-reveal-delay="1">
          <DiffTerminal locale={locale} />
        </div>
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <div class="band-head" data-reveal>
        <h2>{dict.home.partsTitle}</h2>
        <p>{dict.home.partsLede}</p>
      </div>

      <div class="parts">
        {
          parts.map((part, index) => (
            <article
              class={part.lead ? "part lead" : "part"}
              data-reveal
              data-reveal-delay={String(index)}
            >
              <h3>
                {part.name}
                <span class="lic">{part.licence}</span>
              </h3>
              <p class="role" translate="no">{part.role}</p>
              <p>{part.pitch}</p>
              <ul>
                {part.points.map((point) => (
                  <li>{point}</li>
                ))}
              </ul>
              <p class="go">
                <a href={part.href}>{part.cta}</a>
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <div class="band-head" data-reveal>
        <h2>{dict.home.trustTitle}</h2>
        <p>{dict.home.trustLede}</p>
      </div>
      <ul class="claims">
        {
          claims.map((claim) => (
            <li data-reveal>
              <h3>{claim.title}</h3>
              <div>
                <p>{claim.body}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="band cta-band">
    <div class="wrap">
      <h2 data-reveal>{dict.home.ctaTitle}</h2>
      <p class="dim" data-reveal data-reveal-delay="1">{dict.home.ctaLede}</p>
      <div class="row cta-row" data-reveal data-reveal-delay="2">
        <a class="btn btn-primary btn-lg" href={localeUrl(locale, "download")}>
          {dict.nav.download}
        </a>
        <a class="btn" href={localeUrl(locale, "guide")}>{dict.nav.guide}</a>
        <a class="btn" href={REPO_URL}>{dict.common.sourceOnGitHub}</a>
      </div>
      <div class="cta-cmd" data-reveal data-reveal-delay="3">
        <Command locale={locale} command={INSTALL_COMMAND} />
      </div>
    </div>
  </section>

  <ReleaseScript locale={locale} />
</Base>

<style>
  .hero {
    padding-block: clamp(40px, 5.5vw, 64px) 0;
  }

  /* Deliberately smaller than the global h1: the map below is competing for
     the same fold, and a headline that pushes it off the screen wins the
     wrong argument. */
  h1 {
    font-size: clamp(2rem, 4.2vw, 3rem);
  }

  /* The headline is a contrast, so it is set as one: the sentence everybody
     else can say is receded, the one only this tool can say is not. The warm
     growth colour is kept out of it and spent on the artefacts below. */
  .given {
    display: block;
    color: var(--faint);
  }

  .second {
    display: block;
    color: #fff;
  }

  h1 {
    max-width: 24ch;
  }

  .lede {
    margin-top: 16px;
    font-size: 1.08rem;
  }

  .hero-actions {
    margin: 22px 0 8px;
    gap: 14px;
  }

  .meta {
    display: inline-flex;
    gap: 8px;
    font-size: 0.8rem;
  }

  .small {
    font-size: 0.88rem;
  }

  .demo-band {
    padding-block: clamp(24px, 3.5vw, 36px) clamp(48px, 7vw, 80px);
  }

  .demo-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 14px;
  }

  .demo-head h2 {
    font-size: clamp(1.25rem, 2.2vw, 1.6rem);
  }

  .demo-cap {
    margin: 14px 0 0;
    font-size: 0.88rem;
    max-width: 80ch;
  }

  /* Not three identical cards: the desktop app is the product, so its column
     is the one that carries weight. */
  .parts {
    display: grid;
    grid-template-columns: 1.15fr 1fr 1fr;
    border: 1px solid var(--line);
    border-radius: var(--r-surface);
    overflow: hidden;
    background: var(--panel);
  }

  .part {
    display: flex;
    flex-direction: column;
    padding: 26px 24px 28px;
    border-left: 1px solid var(--line);
  }

  .part:first-child {
    border-left: 0;
  }

  .part.lead {
    background: linear-gradient(
      180deg,
      rgba(139, 155, 255, 0.09),
      rgba(139, 155, 255, 0)
    );
  }

  .part h3 {
    display: flex;
    align-items: baseline;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 4px;
  }

  .lic {
    font: 400 0.72rem/1 var(--mono);
    color: var(--faint);
    border: 1px solid var(--line-strong);
    border-radius: var(--r-chip);
    padding: 3px 5px;
  }

  .role {
    font-family: var(--mono);
    font-size: 0.78rem;
    color: var(--accent);
    margin-bottom: 14px;
  }

  .part p,
  .part ul {
    max-width: none;
    color: var(--dim);
    font-size: 0.94rem;
  }

  .part ul {
    margin-bottom: 18px;
  }

  .go {
    margin-top: auto;
    margin-bottom: 0;
    padding-top: 6px;
    font-size: 0.93rem;
  }

  .cta-band h2 {
    max-width: 26ch;
  }

  .cta-row {
    margin-top: 24px;
  }

  .cta-cmd {
    margin-top: 22px;
    max-width: 620px;
  }

  @media (max-width: 900px) {
    .parts {
      grid-template-columns: minmax(0, 1fr);
    }

    .part {
      border-left: 0;
      border-top: 1px solid var(--line);
    }

    .part:first-child {
      border-top: 0;
    }
  }
</style>
