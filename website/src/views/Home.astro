---
import Base from "../layouts/Base.astro";
import DiffTerminal from "../components/DiffTerminal.astro";
import Treemap from "../components/demo/Treemap.tsx";
import { t, type Locale } from "../i18n";
import { localeUrl } from "../i18n/routing";
import ReleaseScript from "../components/ReleaseScript.astro";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const dict = t(locale);

// The order is the marketing order, and the grid below turns it into area:
// the app is the big tile, the other two are the small ones. A treemap of the
// product itself, which is the one structural joke the subject earns.
const parts = [
  {
    name: dict.parts.desktopName,
    role: dict.parts.desktopRole,
    pitch: dict.parts.desktopPitch,
    points: dict.parts.desktopPoints,
    cta: dict.parts.desktopCta,
    href: localeUrl(locale, "desktop"),
    lead: true,
  },
  {
    name: dict.parts.cliName,
    role: dict.parts.cliRole,
    pitch: dict.parts.cliPitch,
    points: dict.parts.cliPoints,
    cta: dict.parts.cliCta,
    href: localeUrl(locale, "cli"),
  },
  {
    name: dict.parts.hubName,
    role: dict.parts.hubRole,
    pitch: dict.parts.hubPitch,
    points: dict.parts.hubPoints,
    cta: dict.parts.hubCta,
    href: localeUrl(locale, "hub"),
  },
];

// Folder is left out: the legend is about file kinds, and a folder tile takes
// the colour of what is inside it.
const LEGEND = [
  "image",
  "video",
  "audio",
  "document",
  "archive",
  "code",
  "binary",
  "cache",
  "other",
] as const;

const claims = [
  { title: dict.trust.duTitle, body: dict.trust.duBody },
  { title: dict.trust.capacityTitle, body: dict.trust.capacityBody },
  { title: dict.trust.forecastTitle, body: dict.trust.forecastBody },
  { title: dict.trust.snapshotTitle, body: dict.trust.snapshotBody },
  { title: dict.trust.errorsTitle, body: dict.trust.errorsBody },
  { title: dict.trust.deleteTitle, body: dict.trust.deleteBody },
];
---

<Base
  locale={locale}
  page=""
  title={dict.home.title}
  description={dict.home.description}
>
  <!-- The headline block is deliberately short so the map is still on the
       first screen. The map is the product; it should not need a scroll. -->
  <section class="wrap hero">
    <h1>{dict.home.headline}</h1>
    <p class="lede">{dict.home.lede}</p>

    <div class="row hero-actions">
      <a
        class="btn btn-primary btn-lg"
        href={localeUrl(locale, "download")}
        data-hero-dl="desktop"
        data-match-macos="macos-universal.dmg"
        data-match-windows="windows-x86_64-setup.exe"
        data-match-linux="linux-x86_64.deb"
      >
        <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path
            d="M8 1.5v9m0 0L4.5 7M8 10.5 11.5 7M2 13.5h12"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"></path>
        </svg>
        {dict.home.ctaPrimary}
      </a>
      <a class="btn btn-lg" href={localeUrl(locale, "cli")}>
        {dict.home.ctaSecondary}
      </a>
    </div>
    <p class="faint small no-account">{dict.home.noAccount}</p>
  </section>

  <section class="wrap map-band" aria-label={dict.home.demoCap}>
    <!-- client:load, not client:visible: the map is above the fold, so
         "wait until it scrolls into view" would only delay the one thing a
         visitor is meant to touch. -->
    <Treemap
      client:load
      locale={locale}
      labels={{
        zoomHint: dict.demo.zoomHint,
        tapHint: dict.demo.tapHint,
        backHint: dict.demo.backHint,
        rootLabel: dict.demo.rootLabel,
        basisLabel: dict.demo.basisLabel,
        onDisk: dict.demo.onDisk,
        logical: dict.demo.logical,
        basisHelp: dict.demo.basisHelp,
        sparseCallout: dict.demo.sparseCallout,
        selected: dict.demo.selected,
        share: dict.demo.share,
        kind: dict.demo.kind,
        sparse: dict.demo.sparse,
        empty: dict.demo.empty,
        emptyHelp: dict.demo.emptyHelp,
        entries: dict.demo.entries,
        categories: dict.categories,
      }}
    />
    <p class="faint map-cap">{dict.home.demoCap}</p>
  </section>

  <section class="band">
    <div class="wrap">
      <div class="split aside">
        <div data-reveal>
          <h2>{dict.home.diffTitle}</h2>
          <p class="dim lede">{dict.home.diffLede}</p>
        </div>
        <div data-reveal data-reveal-delay="1">
          <DiffTerminal locale={locale} />
        </div>
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <div class="band-head" data-reveal>
        <h2>{dict.home.partsTitle}</h2>
        <p>{dict.home.partsLede}</p>
      </div>

      <div class="parts">
        {
          parts.map((part, index) => (
            <article
              class={part.lead ? "part lead" : "part"}
              data-reveal
              data-reveal-delay={String(index)}
            >
              <p class="role">{part.role}</p>
              <h3>{part.name}</h3>
              <p class="pitch">{part.pitch}</p>
              <ul>
                {part.points.map((point) => (
                  <li>{point}</li>
                ))}
              </ul>
              {part.lead && (
                <ul class="legend" aria-label={dict.demo.kind}>
                  {LEGEND.map((category) => (
                    <li>
                      <span
                        class="swatch"
                        style={`--swatch: var(--cat-${category})`}
                        aria-hidden="true"
                      />
                      {dict.categories[category]}
                    </li>
                  ))}
                </ul>
              )}
              <a class="go" href={part.href}>{part.cta}</a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <div class="band-head" data-reveal>
        <h2>{dict.home.trustTitle}</h2>
        <p>{dict.home.trustLede}</p>
      </div>
      <ul class="claims">
        {
          claims.map((claim) => (
            <li data-reveal>
              <h3>{claim.title}</h3>
              <div>
                <p>{claim.body}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="band cta-band">
    <div class="wrap">
      <h2 data-reveal>{dict.home.ctaTitle}</h2>
      <p class="dim lede" data-reveal data-reveal-delay="1">{dict.home.ctaLede}</p>
      <div class="row cta-row" data-reveal data-reveal-delay="2">
        <a class="btn btn-primary btn-lg" href={localeUrl(locale, "download")}>
          {dict.nav.download}
        </a>
        <a class="btn btn-lg" href={localeUrl(locale, "guide")}>
          {dict.nav.guide}
        </a>
      </div>
    </div>
  </section>

  <ReleaseScript locale={locale} />
</Base>

<style>
  .hero {
    padding-block: clamp(48px, 7vw, 92px) clamp(28px, 4vw, 44px);
  }

  .hero h1 {
    max-width: 20ch;
  }

  .hero .lede {
    margin-top: clamp(18px, 2.4vw, 26px);
  }

  .hero-actions {
    margin-top: clamp(26px, 3.4vw, 38px);
    gap: 12px;
  }

  .no-account {
    margin-top: 16px;
  }

  /* The map sits in its own band with no heading above it. A heading here
     would be a label on something that explains itself by being touched. */
  .map-band {
    padding-block: 0 clamp(56px, 7vw, 96px);
  }

  .map-cap {
    margin: 16px 0 0;
    font-size: var(--t-sm);
  }

  /* Three products, laid out as the treemap they describe: the app is one
     large tile, the other two are stacked small ones beside it. The areas
     carry the priority, so no 01/02/03 markers are needed to imply order. */
  .parts {
    display: grid;
    grid-template-columns: minmax(0, 1.12fr) minmax(0, 1fr);
    gap: 14px;
  }

  .part {
    display: flex;
    flex-direction: column;
    align-items: start;
    gap: 10px;
    padding: clamp(22px, 2.6vw, 32px);
    border: 1px solid var(--line);
    border-radius: var(--r-surface);
    background: var(--panel);
  }

  .part.lead {
    grid-row: span 2;
    background: linear-gradient(
      165deg,
      var(--panel-raised),
      var(--panel) 62%
    );
    border-color: var(--line-strong);
  }

  .role {
    margin: 0;
    color: var(--faint);
    font-size: var(--t-sm);
  }

  .part h3 {
    margin: 0;
  }

  .part.lead h3 {
    font-size: var(--t-xl);
    font-stretch: var(--w-head);
    letter-spacing: -0.025em;
  }

  .pitch {
    margin: 0;
    color: var(--dim);
  }

  .part ul {
    margin: 4px 0 0;
    padding-left: 1.15em;
    color: var(--dim);
    font-size: var(--t-sm);
    max-width: none;
  }

  .part li {
    margin-bottom: 0.35em;
  }

  /* Pushed to the bottom so the three cards' links align on one line
     regardless of how much copy sits above them. */
  .go {
    margin-top: auto;
    padding-top: 14px;
    font-weight: 550;
    text-decoration: none;
  }

  .go:hover {
    text-decoration: underline;
  }

  /* `.part ul` (0,0,1,1) beats a bare `.legend` (0,0,1,0), so its
     `margin: 4px 0 0` was silently cancelling the auto top margin that
     pushes this block to the bottom of the card. Matched at the same
     specificity to win on order. */
  .part ul.legend {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 16px;
    list-style: none;
    padding: 0;
    margin: auto 0 0;
    max-width: none;
    font-size: var(--t-sm);
    color: var(--dim);
  }

  .part ul.legend li {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    margin: 0;
  }

  .swatch {
    width: 10px;
    height: 10px;
    border-radius: 2px;
    background: var(--swatch);
    flex: none;
  }

  /* Two `margin-top: auto` siblings in a flex column split the free space
     between them, which would open a gap above the legend AND above the link.
     On the lead card the legend is the element that claims the space, so the
     link sits directly under it. */
  .part.lead .go {
    margin-top: 0;
  }

  .cta-band h2 {
    max-width: 26ch;
  }

  .cta-row {
    margin-top: clamp(24px, 3vw, 34px);
  }

  @media (max-width: 900px) {
    .parts {
      grid-template-columns: minmax(0, 1fr);
    }

    .part.lead {
      grid-row: auto;
    }
  }
</style>
