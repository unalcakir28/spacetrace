---
import Base from "../layouts/Base.astro";
import AppWindow from "../components/AppWindow.astro";
import ReleaseScript from "../components/ReleaseScript.astro";
import { t, type Locale } from "../i18n";
import { localeUrl } from "../i18n/routing";
import { DESKTOP_REPO_URL } from "../data/releases";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const dict = t(locale);

const features = [
  { title: dict.desktop.f1Title, body: dict.desktop.f1Body },
  { title: dict.desktop.f2Title, body: dict.desktop.f2Body },
  { title: dict.desktop.f3Title, body: dict.desktop.f3Body },
  { title: dict.desktop.f4Title, body: dict.desktop.f4Body },
  { title: dict.desktop.f5Title, body: dict.desktop.f5Body },
  { title: dict.desktop.f6Title, body: dict.desktop.f6Body },
];

const sources = [
  { title: dict.desktop.s1Title, body: dict.desktop.s1Body },
  { title: dict.desktop.s2Title, body: dict.desktop.s2Body },
  { title: dict.desktop.s3Title, body: dict.desktop.s3Body },
  { title: dict.desktop.s4Title, body: dict.desktop.s4Body },
];
---

<Base
  locale={locale}
  page="desktop"
  title={dict.desktop.title}
  description={dict.desktop.description}
>
  <section class="wrap hero">
    <p class="kicker">{dict.desktop.kicker}</p>
    <h1>
      <span class="given">{dict.desktop.headlineGiven}</span>
      <span class="second">{dict.desktop.headlineSecond}</span>
    </h1>
    <p class="lede">{dict.desktop.lede}</p>
    <div class="row hero-actions">
      <a
        class="btn btn-primary btn-lg"
        href={localeUrl(locale, "download")}
        data-hero-dl="desktop"
        data-match-macos="macos-universal.dmg"
        data-match-windows="windows-x86_64-setup.exe"
        data-match-linux="linux-x86_64.deb"
      >
        {dict.desktop.ctaPrimary}
      </a>
      <span class="faint mono meta">
        <span data-size></span>
        <span data-version="desktop">{dict.common.latestBuild}</span>
      </span>
      <a class="btn" href={`${localeUrl(locale, "download")}#desktop`}>
        {dict.desktop.ctaSecondary}
      </a>
    </div>

    <div class="win-holder" data-reveal>
      <AppWindow locale={locale} />
    </div>
    <p class="faint cap">{dict.desktop.windowCaption}</p>
  </section>

  <section class="band">
    <div class="wrap">
      <div class="band-head" data-reveal>
        <h2>{dict.desktop.featuresTitle}</h2>
        <p>{dict.desktop.featuresLede}</p>
      </div>
      <ul class="claims">
        {
          features.map((feature) => (
            <li data-reveal>
              <h3>{feature.title}</h3>
              <div>
                <p>{feature.body}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <div class="split aside">
        <div data-reveal>
          <h2>{dict.desktop.sourcesTitle}</h2>
          <p class="dim">{dict.desktop.sourcesLede}</p>
        </div>
        <dl class="ref" data-reveal data-reveal-delay="1">
          {
            sources.map((source) => (
              <>
                <dt class="plain">{source.title}</dt>
                <dd>{source.body}</dd>
              </>
            ))
          }
        </dl>
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <div class="split">
        <div data-reveal>
          <h2>{dict.desktop.safetyTitle}</h2>
          <p class="dim">{dict.desktop.safetyBody1}</p>
          <p class="dim">{dict.desktop.safetyBody2}</p>
          <p class="dim">{dict.desktop.safetyBody3}</p>
        </div>
        <div data-reveal data-reveal-delay="1">
          <h2>{dict.desktop.notYetTitle}</h2>
          <p class="dim">{dict.desktop.notYetLede}</p>
          <ul class="dim">
            {dict.desktop.notYet.map((item) => <li>{item}</li>)}
          </ul>
          <p class="faint small">
            <a href={DESKTOP_REPO_URL}>{DESKTOP_REPO_URL.replace("https://", "")}</a>
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="band cta-band">
    <div class="wrap">
      <h2 data-reveal>{dict.home.ctaTitle}</h2>
      <div class="row cta-row" data-reveal data-reveal-delay="1">
        <a class="btn btn-primary btn-lg" href={`${localeUrl(locale, "download")}#desktop`}>
          {dict.desktop.ctaPrimary}
        </a>
        <a class="btn" href={localeUrl(locale, "guide")}>{dict.nav.guide}</a>
      </div>
    </div>
  </section>

  <ReleaseScript locale={locale} />
</Base>

<style>
  .hero {
    padding-block: clamp(44px, 7vw, 76px) clamp(48px, 7vw, 80px);
  }

  .given {
    display: block;
    color: var(--faint);
  }

  .second {
    display: block;
    color: #fff;
  }

  h1 {
    max-width: 22ch;
  }

  .lede {
    margin-top: 20px;
  }

  .hero-actions {
    margin: 26px 0 0;
    gap: 14px;
  }

  .meta {
    display: inline-flex;
    gap: 8px;
    font-size: 0.8rem;
  }

  .win-holder {
    margin-top: 36px;
  }

  .cap {
    margin-top: 12px;
    font-size: 0.86rem;
    max-width: 76ch;
  }

  /* These are titles, not commands, so they do not take the monospace face
     the reference list uses by default. */
  dl.ref dt.plain {
    font-family: var(--cond);
    font-size: 1rem;
    font-weight: 600;
    color: var(--text);
  }

  .small {
    font-size: 0.86rem;
  }

  .cta-row {
    margin-top: 22px;
  }
</style>
