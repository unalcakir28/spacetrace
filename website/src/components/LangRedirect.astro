---
import { LOCALES, DEFAULT_LOCALE, type Locale } from "../i18n";
import { localeUrl, type Page } from "../i18n/routing";

interface Props {
  locale: Locale;
  page: Page;
}
const { locale, page } = Astro.props;

// The target URL for every language is computed at build time, so the inline
// script does no string surgery on the current path — it just picks one of five
// ready-made hrefs. That is what keeps it small enough to run before paint.
const targets = Object.fromEntries(
  LOCALES.filter((l) => l !== DEFAULT_LOCALE).map((l) => [l, localeUrl(l, page)]),
) as Record<string, string>;

const isDefault = locale === DEFAULT_LOCALE;

/*
  Automatic language, done from the browser because GitHub Pages has no server
  to read Accept-Language with. Four rules, and each one exists to stop this
  being user-hostile:

  1. It only ever fires on the unprefixed pages — the English ones. A URL that
     names a language (/tr/hub/) is somebody's deliberate choice or somebody's
     shared link, and moving them off it would be wrong.
  2. An explicit choice wins for good. Picking a language in the switcher
     writes it down, and after that this never runs again.
  3. If English appears anywhere in the browser's preference list before one of
     our other four, nothing happens. A reader of English is left alone.
  4. Any failure — private mode throwing on storage, a browser with no
     navigator.languages — leaves the page exactly where it is.

  `is:inline` and in the head: a deferred module would paint English first and
  then jump, which is worse than not doing it at all.

  Two Astro traps are deliberately avoided here, both of which ship silently:

  - Writing the body as `{`…`}` inside `<script>` children. Inside an Astro
    expression like `{cond && <script>…</script>}` the children are text, so
    the wrapper is emitted verbatim and the result is a block statement
    containing a discarded string — valid JavaScript that does nothing.
  - Combining `define:vars` with `set:html`. `define:vars` wins and the body
    disappears, leaving an IIFE that only declares consts.

  So there is one mechanism: the whole thing, values included, is built as a
  string here and handed to `set:html`. The values are build-time constants
  from our own routing table, serialised with JSON.stringify.
*/
const SCRIPT = `(function () {
  var targets = ${JSON.stringify(targets)};
  var fallback = ${JSON.stringify(DEFAULT_LOCALE)};
  var key = "spacetrace.lang";
  var flag = "spacetrace.auto";

try {
  if (window.localStorage.getItem(key)) return;

  var wanted = navigator.languages && navigator.languages.length
    ? navigator.languages
    : [navigator.language];

  for (var i = 0; i < wanted.length; i++) {
    var tag = String(wanted[i] || "").toLowerCase().split("-")[0];
    // Read in preference order and stop at the first tag we recognise: if
    // English comes first, this reader wants English and we are done.
    if (tag === fallback) return;
    if (Object.prototype.hasOwnProperty.call(targets, tag)) {
      window.sessionStorage.setItem(flag, tag);
      // replace(), not assign(): Back should return to wherever the reader
      // came from, not to a page that immediately bounces them again.
      window.location.replace(targets[tag]);
      return;
    }
  }
} catch (e) {
  /* stay put */
}
})();`;
---

{
  isDefault && (
    <script is:inline set:html={SCRIPT} />
  )
}
