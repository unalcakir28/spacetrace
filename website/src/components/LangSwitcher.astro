---
import { t, LOCALE_NAMES, LOCALES, type Locale } from "../i18n";
import { localeUrl, type Page } from "../i18n/routing";

interface Props {
  locale: Locale;
  page: Page;
}
const { locale, page } = Astro.props;
const dict = t(locale);
---

<!-- A <details> rather than a scripted popover: it opens, closes, takes focus
     and responds to Escape without a line of JavaScript, and each option is a
     real link, so the current page is preserved in the new language and can be
     opened in a new tab. -->
<details class="lang">
  <summary aria-label={dict.locale.pick}>
    <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
      <circle cx="8" cy="8" r="6.25" stroke="currentColor" stroke-width="1.3"
      ></circle>
      <path
        d="M1.9 6.2h12.2M1.9 9.8h12.2M8 1.8c-3.4 3.6-3.4 8.8 0 12.4 3.4-3.6 3.4-8.8 0-12.4Z"
        stroke="currentColor"
        stroke-width="1.3"
      ></path>
    </svg>
    <span class="code">{locale.toUpperCase()}</span>
  </summary>
  <ul>
    {
      LOCALES.map((l) => (
        <li>
          <a
            href={localeUrl(l, page)}
            lang={l}
            hreflang={l}
            aria-current={l === locale ? "true" : undefined}
          >
            <span class="code">{l.toUpperCase()}</span>
            {LOCALE_NAMES[l]}
          </a>
        </li>
      ))
    }
  </ul>
</details>

<style>
  .lang {
    position: relative;
  }

  summary {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    list-style: none;
    cursor: pointer;
    padding: 6px 9px;
    border: 1px solid var(--line-strong);
    border-radius: var(--r-control);
    color: var(--dim);
    font-size: var(--t-xs);
    transition:
      background var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary:hover {
    background: var(--panel-raised);
    color: var(--text);
  }

  summary svg {
    width: 14px;
    height: 14px;
  }

  .code {
    font-family: var(--mono);
    font-size: var(--t-2xs);
    letter-spacing: 0.02em;
  }

  ul {
    position: absolute;
    right: 0;
    top: calc(100% + 8px);
    z-index: 40;
    margin: 0;
    padding: 5px;
    min-width: 168px;
    list-style: none;
    background: var(--panel-raised);
    border: 1px solid var(--line-strong);
    border-radius: var(--r-control);
    box-shadow: 0 18px 40px -16px rgba(0, 0, 0, 0.85);
  }

  li {
    margin: 0;
  }

  a {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 10px;
    border-radius: var(--r-chip);
    color: var(--dim);
    text-decoration: none;
    font-size: var(--t-sm);
  }

  a:hover {
    background: var(--panel-high);
    color: #fff;
  }

  a[aria-current="true"] {
    color: var(--accent-bright);
  }

  a .code {
    color: var(--faint);
    min-width: 22px;
  }

  /* Origin-aware: the menu grows out of the button that opened it, not from
     its own middle. */
  @media (prefers-reduced-motion: no-preference) {
    details[open] ul {
      animation: pop var(--dur) var(--ease-out);
      transform-origin: top right;
    }

    @keyframes pop {
      from {
        opacity: 0;
        transform: scale(0.96) translateY(-4px);
      }
      to {
        opacity: 1;
        transform: none;
      }
    }
  }
</style>

<script>
  const KEY = "spacetrace.lang";

  // Choosing a language here is deliberate, so it is written down: the
  // automatic detection in LangRedirect.astro checks this first and never runs
  // again once it is set. Without this, a Turkish browser would keep pulling
  // somebody who wants English back to /tr/.
  for (const link of document.querySelectorAll<HTMLAnchorElement>(
    "details.lang a[hreflang]",
  )) {
    link.addEventListener("click", () => {
      try {
        window.localStorage.setItem(KEY, link.hreflang);
      } catch {
        /* the link still navigates; only the memory is lost */
      }
    });
  }

  // A <details> does not close when you click elsewhere, which for a menu is
  // wrong: the click that dismisses it is almost always a click on something
  // else. Escape is handled too, because the keyboard should not be a
  // second-class way out.
  for (const menu of document.querySelectorAll<HTMLDetailsElement>(
    "details.lang",
  )) {
    document.addEventListener("click", (event) => {
      if (!menu.open) return;
      if (event.target instanceof Node && menu.contains(event.target)) return;
      menu.open = false;
    });

    menu.addEventListener("keydown", (event) => {
      if (event.key !== "Escape") return;
      menu.open = false;
      menu.querySelector("summary")?.focus();
    });
  }
</script>
