---
import { t, type Locale } from "../i18n";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const dict = t(locale);

// The folder panel's rows. `share` is the width of the bar and `cat` the
// colour: a folder takes the colour of what it is *full of*, found by following
// the largest child down to a file. Colouring by "directory" would paint every
// row the same, which is no information at all.
const rows = [
  { name: "you/", size: "87.4 GiB", pct: "", share: 100, cat: "other", here: true, depth: 0 },
  { name: "Library/", size: "38.2 GiB", pct: "44%", share: 44, cat: "other", depth: 1 },
  { name: "Containers/", size: "19.4 GiB", pct: "22%", share: 22, cat: "archive", depth: 2 },
  { name: "Pictures/", size: "12.7 GiB", pct: "15%", share: 15, cat: "image", depth: 1 },
  { name: "projects/", size: "6.1 GiB", pct: "7%", share: 7, cat: "code", depth: 1 },
  { name: "Movies/", size: "4.9 GiB", pct: "6%", share: 6, cat: "video", depth: 1 },
  { name: "Music/", size: "2.2 GiB", pct: "3%", share: 3, cat: "audio", depth: 1 },
  { name: "Downloads/", size: "1.8 GiB", pct: "2%", share: 2, cat: "document", depth: 1 },
  { name: ".cache/", size: "1.1 GiB", pct: "1%", share: 1.5, cat: "cache", depth: 1 },
];

const CATEGORIES = [
  "image",
  "video",
  "audio",
  "document",
  "archive",
  "code",
  "binary",
  "cache",
  "other",
] as const;
---

<figure class="win">
  <figcaption class="visually-hidden">
    {dict.desktop.windowCaption}
  </figcaption>

  <div class="win-bar">
    <span class="app" translate="no">spacetrace</span>
    <span class="faint">{dict.home.kicker}</span>
    <span class="spacer"></span>
    <span class="basis" role="img" aria-label={dict.demo.basisLabel}>
      <span class="on">{dict.demo.onDisk}</span><span>{dict.demo.logical}</span>
    </span>
    <span class="meter">
      <span class="bar"></span>
      <span translate="no">61.0 GiB {dict.common.free} / 994.0 GiB</span>
    </span>
  </div>

  <div class="win-source">
    <span class="live">● live scan</span>
    <span class="path" translate="no">/Users/you</span>
    <b translate="no">87.4 GiB</b>
    <span class="faint" translate="no">· 1.1 TiB · 412,908 {dict.demo.entries}</span>
    <span class="bad">3 unreadable</span>
  </div>

  <div class="win-body">
    <div class="folders">
      {
        rows.map((row) => (
          <div class={row.here ? "row here" : "row"}>
            <span class="nm" style={`padding-left:${row.depth * 12}px`} translate="no">
              {row.name}
            </span>
            <span class="sz" translate="no">{row.size}</span>
            <span class="pc">{row.pct}</span>
            <span class="share">
              <i style={`width:${row.share}%;background:var(--cat-${row.cat})`} />
            </span>
          </div>
        ))
      }
    </div>

    <div class="map">
      <div class="tile big on-dark" style="grid-area:big;background:var(--cat-other)">
        <span class="n" translate="no">Library/Containers</span>
        <span class="s" translate="no">38.2 GiB</span>
      </div>
      <div class="tile" style="grid-area:docker;background:var(--cat-archive)">
        <span class="n" translate="no">Docker.raw</span>
        <span class="s" translate="no">19.4 GiB</span>
        <span class="flag" translate="no">~ 1.0 TiB</span>
      </div>
      <div class="tile" style="grid-area:photos;background:var(--cat-image)">
        <span class="n" translate="no">Pictures</span>
        <span class="s" translate="no">12.7 GiB</span>
      </div>
      <div class="tile" style="grid-area:node;background:var(--cat-code)">
        <span class="n" translate="no">node_modules</span>
        <span class="s" translate="no">6.1 GiB</span>
      </div>
      <div class="tile" style="grid-area:movies;background:var(--cat-video)">
        <span class="n" translate="no">Movies</span>
        <span class="s" translate="no">4.9 GiB</span>
      </div>
      <div class="tile" style="grid-area:music;background:var(--cat-audio)">
        <span class="n" translate="no">Music</span>
        <span class="s" translate="no">2.2 GiB</span>
      </div>
      <div class="tile" style="grid-area:downloads;background:var(--cat-document)">
        <span class="n" translate="no">Downloads</span>
        <span class="s" translate="no">1.8 GiB</span>
      </div>
      <div class="tile" style="grid-area:cache;background:var(--cat-cache)">
        <span class="n" translate="no">.cache</span>
        <span class="s" translate="no">1.1 GiB</span>
      </div>
    </div>

    <div class="inspect">
      <h4 translate="no">Docker.raw</h4>
      <dl>
        <dt>{dict.demo.onDisk}</dt>
        <dd translate="no">19.4 GiB</dd>
        <dt>{dict.demo.logical}</dt>
        <dd translate="no">1.0 TiB</dd>
        <dt>{dict.demo.share}</dt>
        <dd translate="no">22%</dd>
        <dt>{dict.demo.kind}</dt>
        <dd>{dict.categories.archive} · {dict.demo.sparse}</dd>
      </dl>
      <p class="sparse">{dict.demo.sparseCallout}</p>
    </div>
  </div>

  <div class="win-foot">
    <ul class="legend">
      {
        CATEGORIES.map((cat) => (
          <li>
            <i style={`background:var(--cat-${cat})`} />
            {dict.categories[cat]}
          </li>
        ))
      }
    </ul>
  </div>
</figure>

<style>
  /* Drawn from the application's own stylesheet values rather than
     screenshotted: a bitmap of a window goes stale the week after it is taken,
     cannot be read by a screen reader, and looks soft on a retina display
     unless it is a megabyte. */
  .win {
    margin: 0;
    border: 1px solid var(--line-strong);
    border-radius: var(--r-surface);
    overflow: hidden;
    background: var(--bg);
    box-shadow: 0 30px 80px -34px rgba(0, 0, 0, 0.95);
    font-family: var(--mono);
    font-size: 0.73rem;
    line-height: 1.5;
  }

  .win-bar {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    padding: 8px 12px;
    background: var(--panel);
    border-bottom: 1px solid var(--line);
  }

  .app {
    font-family: var(--cond);
    font-weight: 700;
    font-size: 0.9rem;
    color: var(--text);
  }

  .spacer {
    margin-left: auto;
  }

  .basis {
    display: inline-flex;
    border: 1px solid var(--line-strong);
    border-radius: var(--r-control);
    overflow: hidden;
  }

  .basis span {
    padding: 4px 9px;
    color: var(--faint);
  }

  .basis span.on {
    background: var(--accent-deep);
    color: var(--accent-bright);
  }

  .meter {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border: 1px solid var(--line-strong);
    border-radius: var(--r-control);
    padding: 4px 9px;
    color: var(--dim);
  }

  .meter .bar {
    width: 72px;
    height: 5px;
    border-radius: 3px;
    background: var(--panel-high);
    position: relative;
    overflow: hidden;
  }

  .meter .bar::after {
    content: "";
    position: absolute;
    inset: 0 38% 0 0;
    background: var(--hot);
  }

  .win-source {
    display: flex;
    align-items: center;
    gap: 9px;
    flex-wrap: wrap;
    padding: 6px 12px;
    border-bottom: 1px solid var(--line);
    color: var(--faint);
  }

  .live {
    color: var(--shrink);
  }

  .path,
  b {
    color: var(--text);
  }

  b {
    font-weight: 600;
  }

  .bad {
    color: var(--alarm);
    border: 1px solid rgba(255, 107, 107, 0.4);
    border-radius: var(--r-chip);
    padding: 1px 6px;
  }

  .win-body {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr) minmax(0, 4fr);
  }

  .win-body > * {
    border-left: 1px solid var(--line);
    min-width: 0;
  }

  .win-body > :first-child {
    border-left: 0;
  }

  .folders {
    padding: 8px 0;
  }

  .row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto 30px 54px;
    gap: 8px;
    align-items: center;
    padding: 2px 12px;
    color: var(--dim);
  }

  .row.here {
    background: var(--accent-deep);
    color: var(--text);
  }

  .nm {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .sz {
    color: var(--text);
    font-variant-numeric: tabular-nums;
  }

  .pc {
    color: var(--faint);
    text-align: right;
    font-variant-numeric: tabular-nums;
  }

  .share {
    height: 4px;
    border-radius: 2px;
    background: var(--panel-high);
    overflow: hidden;
  }

  .share i {
    display: block;
    height: 100%;
  }

  /* A squarified layout, laid out by hand: the areas are the proportions of a
     real home folder, biggest first. */
  .map {
    display: grid;
    grid-template-columns: 3fr 2fr 2fr;
    grid-template-rows: repeat(5, 1fr);
    grid-template-areas:
      "big docker photos"
      "big docker photos"
      "big docker node"
      "big movies node"
      "music downloads cache";
    gap: 3px;
    padding: 3px;
    height: 262px;
  }

  .tile {
    border-radius: 4px;
    padding: 7px 9px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    color: rgba(8, 11, 20, 0.84);
  }

  .tile.on-dark {
    color: rgba(234, 238, 251, 0.94);
  }

  .tile .n {
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .tile .s {
    opacity: 0.74;
  }

  .tile.big {
    font-size: 0.92rem;
  }

  .flag {
    margin-top: auto;
    font-size: 0.68rem;
    opacity: 0.8;
  }

  .inspect {
    padding: 10px 12px;
  }

  .inspect h4 {
    font-family: var(--mono);
    font-size: 0.84rem;
    color: #fff;
    margin-bottom: 8px;
  }

  .inspect dl {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 3px 12px;
    margin: 0;
  }

  .inspect dt {
    color: var(--faint);
  }

  .inspect dd {
    margin: 0;
    color: var(--text);
    font-variant-numeric: tabular-nums;
  }

  .sparse {
    margin: 10px 0 0;
    max-width: none;
    color: var(--hot);
    font-size: 0.7rem;
    line-height: 1.45;
  }

  .win-foot {
    border-top: 1px solid var(--line);
    padding: 7px 12px;
    background: var(--panel);
  }

  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 5px 16px;
    margin: 0;
    padding: 0;
    max-width: none;
    list-style: none;
    color: var(--faint);
    font-size: 0.68rem;
  }

  .legend li {
    display: flex;
    align-items: center;
    gap: 6px;
    margin: 0;
  }

  .legend i {
    width: 8px;
    height: 8px;
    border-radius: 2px;
    flex: none;
  }

  @media (max-width: 900px) {
    .win-body {
      grid-template-columns: minmax(0, 1fr);
    }

    .win-body > * {
      border-left: 0;
      border-top: 1px solid var(--line);
    }

    .win-body > :first-child {
      border-top: 0;
    }
  }
</style>
