---
import { t, type Locale } from "../i18n";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const dict = t(locale);

// The labels have to reach the browser somehow, and a data attribute keeps the
// translation in the same place as every other string rather than duplicating
// the dictionary into the script bundle.
const labels = JSON.stringify({
  latestBuild: dict.common.latestBuild,
  stable: dict.common.stableRelease,
  notARelease: dict.common.notARelease,
});
---

<span hidden data-release-config={labels} data-release-locale={locale}></span>

<script>
  import { initReleases } from "../scripts/releases";

  const config = document.querySelector<HTMLElement>("[data-release-config]");
  const locale = config?.dataset.releaseLocale ?? "en";
  let labels = {
    latestBuild: "latest build",
    stable: "stable release",
    notARelease: "built from main",
  };
  try {
    labels = { ...labels, ...JSON.parse(config?.dataset.releaseConfig ?? "{}") };
  } catch {
    /* the defaults are English, which is better than a crash */
  }
  initReleases(locale, labels);
</script>
