---
import { t, type Locale } from "../i18n";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const dict = t(locale);

// Real output from the repository's own README, not invented: this is what the
// command prints. The numbers are the ones in the project's test fixtures.
const rows = [
  { change: "+40.1 MiB", status: "grew", now: "42.9 MiB", path: "app/logs/", culprit: true },
  { change: "+14.3 MiB", status: "grew", now: "25.7 MiB", path: "backups/" },
  { change: "−1.9 MiB", status: "removed", now: "0 B", path: "uploads/", gone: true },
];
---

<figure class="term" data-term>
  <div class="term-bar">
    <span class="dot" aria-hidden="true"></span>
    <span class="dot" aria-hidden="true"></span>
    <span class="dot" aria-hidden="true"></span>
    <span class="host" translate="no">srv-01 — /srv</span>
    <button type="button" class="replay" data-term-replay>
      <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path
          d="M13.5 8a5.5 5.5 0 1 1-1.9-4.16M13.2 1.9v2.6h-2.6"
          stroke="currentColor"
          stroke-width="1.4"
          stroke-linecap="round"
        ></path>
      </svg>
      {dict.common.replay}
    </button>
  </div>

  <div class="term-body">
    <div class="line" data-step="1">
      <span class="prompt">$</span> <b translate="no">spacetrace diff --path /srv</b>
    </div>
    <div class="line meta" data-step="2" translate="no">
      #1 2026-09-06 17:23 [weekly] → #2 2026-09-06 19:40
    </div>
    <div class="line total" data-step="2" translate="no">
      total 23.8 MiB → 76.3 MiB <b>(+52.5 MiB)</b>
    </div>

    <div class="scroll-x">
      <table class="diff" translate="no">
        <thead>
          <tr data-step="3">
            <th scope="col">CHANGE</th>
            <th scope="col">STATUS</th>
            <th scope="col">NEW</th>
            <th scope="col">PATH</th>
          </tr>
        </thead>
        <tbody>
          {
            rows.map((row, index) => (
              <tr
                class={row.gone ? "gone" : "grew"}
                data-step={String(index + 4)}
              >
                <td class="change">{row.change}</td>
                <td class="status">{row.status}</td>
                <td>{row.now}</td>
                <td class={row.culprit ? "path culprit" : "path"}>{row.path}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </div>

  <figcaption class="visually-hidden">
    {dict.home.diffTitle}
  </figcaption>
</figure>

<style>
  .term {
    margin: 0;
    border: 1px solid var(--line-strong);
    border-radius: var(--r-surface);
    background: linear-gradient(180deg, #101627, #0a0e1a);
    box-shadow: 0 30px 80px -34px rgba(0, 0, 0, 0.9);
    overflow: hidden;
  }

  .term-bar {
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 8px 12px;
    border-bottom: 1px solid var(--line);
    background: rgba(20, 26, 44, 0.7);
    font-family: var(--mono);
    font-size: var(--t-2xs);
    color: var(--faint);
  }

  .dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--line-strong);
    flex: none;
  }

  .dot:first-of-type {
    background: #3c4770;
  }

  .host {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .replay {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    flex: none;
    background: var(--panel-raised);
    border: 1px solid var(--line-strong);
    border-radius: var(--r-control);
    color: var(--dim);
    font: inherit;
    padding: 4px 9px;
    cursor: pointer;
    transition:
      background var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }

  .replay:hover {
    background: var(--panel-high);
    color: #fff;
  }

  .replay svg {
    width: 12px;
    height: 12px;
  }

  .term-body {
    padding: 16px clamp(14px, 3vw, 26px) 20px;
    font-family: var(--mono);
    font-size: clamp(0.74rem, 1.4vw, 0.88rem);
    line-height: 1.75;
  }

  .prompt {
    color: var(--faint);
  }

  .line b {
    color: var(--accent-bright);
    font-weight: 500;
  }

  .meta {
    color: var(--faint);
    margin-top: 8px;
  }

  .total {
    color: var(--dim);
    margin-bottom: 12px;
  }

  .total b {
    color: var(--hot);
    font-weight: 600;
  }

  table.diff {
    border-collapse: collapse;
    width: 100%;
    min-width: 430px;
    font-variant-numeric: tabular-nums;
  }

  table.diff th {
    text-align: right;
    font-weight: 500;
    color: var(--faint);
    font-size: 0.82em;
    letter-spacing: 0.06em;
    padding: 0 14px 6px 0;
    border-bottom: 1px solid var(--line);
    white-space: nowrap;
  }

  table.diff th:last-child,
  table.diff td:last-child {
    text-align: left;
    padding-right: 0;
    width: 100%;
  }

  table.diff td {
    text-align: right;
    padding: 3px 14px 3px 0;
    color: var(--dim);
    white-space: nowrap;
  }

  .change {
    font-weight: 600;
  }

  tr.grew .change {
    color: var(--hot);
  }

  tr.gone .change {
    color: var(--shrink);
  }

  .status {
    color: var(--faint);
  }

  .path {
    color: var(--text);
  }

  /* The culprit is the one thing the report exists to say, so it is the one
     thing marked. */
  .path.culprit {
    color: #fff;
    background: rgba(255, 180, 84, 0.13);
    box-shadow: -2px 0 0 var(--hot);
    padding-left: 8px;
    border-radius: 0 var(--r-chip) var(--r-chip) 0;
  }

  .term-foot {
    border-top: 1px solid var(--line);
    padding: 13px clamp(14px, 3vw, 26px);
    font-size: var(--t-sm);
    color: var(--dim);
    background: rgba(20, 26, 44, 0.45);
  }

  /* The output arrives a line at a time, the way it does in a terminal — one
     orchestrated moment, ~1.1s, replayable, and off entirely under
     prefers-reduced-motion. */
  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .term.play [data-step] {
      opacity: 0;
      animation: term-line 300ms var(--ease-out) forwards;
    }

    :global(html.js) .term.play [data-step="1"] { animation-delay: 60ms; }
    :global(html.js) .term.play [data-step="2"] { animation-delay: 200ms; }
    :global(html.js) .term.play [data-step="3"] { animation-delay: 340ms; }
    :global(html.js) .term.play [data-step="4"] { animation-delay: 480ms; }
    :global(html.js) .term.play [data-step="5"] { animation-delay: 600ms; }
    :global(html.js) .term.play [data-step="6"] { animation-delay: 720ms; }

    @keyframes term-line {
      from {
        opacity: 0;
        transform: translateY(3px);
      }
      to {
        opacity: 1;
        transform: none;
      }
    }
  }

  /* No JavaScript, or reduced motion: everything is simply there. */
  .replay {
    display: none;
  }

  :global(html.js) .replay {
    display: inline-flex;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html.js) .replay {
      display: none;
    }
  }
</style>

<script>
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  for (const term of document.querySelectorAll<HTMLElement>("[data-term]")) {
    const play = () => {
      if (reduced) return;
      // Restart by removing the class, forcing a reflow, then adding it back:
      // an animation cannot be replayed while its class is still applied.
      term.classList.remove("play");
      void term.offsetWidth;
      term.classList.add("play");
    };

    term
      .querySelector<HTMLButtonElement>("[data-term-replay]")
      ?.addEventListener("click", play);

    if (reduced || !("IntersectionObserver" in window)) continue;

    // Played once, when it first comes into view — not on load, because on a
    // long page the output would have finished before it was ever seen.
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          play();
          observer.unobserve(entry.target);
        }
      },
      { threshold: 0.35 },
    );
    observer.observe(term);
  }
</script>
