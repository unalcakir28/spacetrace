---
interface Props {
  size?: number;
}
const { size = 22 } = Astro.props;
---

<!-- The product's thesis as a mark: a squarified treemap in the app's own
     category palette, with exactly one tile in the warm "this grew" colour.
     Five tiles, flat — it has to read at 22px in a navigation bar. -->
<svg viewBox="0 0 24 24" width={size} height={size} aria-hidden="true">
  <rect x="0" y="0" width="13" height="13" rx="1.6" fill="#45d3ba"></rect>
  <rect x="0" y="14" width="13" height="10" rx="1.6" fill="#a98cf0"></rect>
  <rect x="14" y="0" width="10" height="8" rx="1.6" fill="#ffb454"></rect>
  <rect x="14" y="9" width="10" height="5" rx="1.6" fill="#58b4e8"></rect>
  <rect x="14" y="15" width="10" height="9" rx="1.6" fill="#7bd88f"></rect>
</svg>
