---
import { t, type Locale } from "../i18n";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const dict = t(locale);

// Ordered the way the hub orders it: what fills up soonest, then what is
// tight, then what is merely growing. A fleet list sorted by hostname makes
// the reader do the work the tool exists to do.
const targets = [
  {
    host: "db-02",
    root: "/var/lib/postgresql",
    free: "18.2 GiB / 500 GiB",
    freeClass: "tight",
    growth: "+3.1 GiB/day",
    spark: "0,17 12,16 24,14 36,11 48,8 60,5 76,1",
    sparkColor: "#ff6b6b",
    fills: "6",
    urgent: true,
  },
  {
    host: "nas",
    root: "/volume1/backups",
    free: "402 GiB / 8.0 TiB",
    freeClass: "warm",
    growth: "+41 GiB/day",
    spark: "0,18 12,16 24,15 36,12 48,10 60,7 76,4",
    sparkColor: "#ffb454",
    fills: "10",
    urgent: true,
  },
  {
    host: "srv-01",
    root: "/srv",
    free: "120 GiB / 400 GiB",
    freeClass: "",
    growth: "+1.4 GiB/day",
    spark: "0,15 12,14 24,13 36,13 48,11 60,10 76,9",
    sparkColor: "#ffb454",
    fills: "85",
  },
  {
    host: "ci-runner-1",
    root: "/var/lib/docker",
    free: "96 GiB / 250 GiB",
    freeClass: "",
    growth: "−2.0 GiB/day",
    growthDown: true,
    spark: "0,4 12,9 24,3 36,12 48,6 60,14 76,8",
    sparkColor: "#5ee0a0",
    withheld: "r² 0.11",
  },
  {
    host: "build-03",
    root: "/home",
    free: "1.1 TiB / 2.0 TiB",
    freeClass: "",
    growthWithheld: true,
    spark: "48,12 62,11 76,11",
    sparkColor: "#737e9f",
    withheld: dict.hub.fleetTwoSnapshots,
  },
  {
    host: "mail",
    root: "/var/mail",
    freeWithheld: true,
    growth: "+180 MiB/day",
    spark: "0,14 12,13 24,13 36,12 48,11 60,11 76,10",
    sparkColor: "#ffb454",
    withheld: "",
  },
];
---

<figure class="fleet-win">
  <div class="fleet-bar">
    <span class="app" translate="no">spacetrace hub</span>
    <span class="faint">fleet</span>
    <span class="spacer"></span>
    <span class="chip">{dict.hub.alertsTitle}</span>
    <span class="chip">{dict.parts.cliName}</span>
  </div>
  <div class="fleet-source">
    7 {dict.hub.fleetTargets} · 6 {dict.hub.fleetReporting} · 1 {dict.hub.fleetSilent}
  </div>

  <div class="scroll-x">
    <table class="fleet">
      <thead>
        <tr>
          <th scope="col">{dict.hub.fleetHost}</th>
          <th scope="col">{dict.hub.fleetRoot}</th>
          <th scope="col">{dict.hub.fleetFree}</th>
          <th scope="col">{dict.hub.fleetGrowth}</th>
          <th scope="col">{dict.hub.fleetTrend}</th>
          <th scope="col">{dict.hub.fleetFills}</th>
        </tr>
      </thead>
      <tbody>
        {
          targets.map((target) => (
            <tr class={target.urgent ? "urgent" : undefined}>
              <td class="host" translate="no">{target.host}</td>
              <td translate="no">{target.root}</td>
              <td class={`free ${target.freeClass ?? ""}`}>
                {target.freeWithheld ? (
                  <span class="withheld">— {dict.hub.fleetNoCapacity}</span>
                ) : (
                  <span translate="no">{target.free}</span>
                )}
              </td>
              <td class={target.growthDown ? "growth down" : "growth"}>
                {target.growthWithheld ? (
                  <span class="withheld">—</span>
                ) : (
                  <span translate="no">{target.growth}</span>
                )}
              </td>
              <td>
                <svg viewBox="0 0 76 20" aria-hidden="true">
                  <polyline
                    points={target.spark}
                    fill="none"
                    stroke={target.sparkColor}
                    stroke-width="1.5"
                  />
                </svg>
              </td>
              <td class={target.fills ? "fills" : "withheld"}>
                {
                  target.fills
                    ? `${target.fills} ${dict.hub.fleetDays}`
                    : `— ${target.withheld}`
                }
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <figcaption class="fleet-foot">{dict.hub.withheldNote}</figcaption>
</figure>

<style>
  .fleet-win {
    margin: 0;
    border: 1px solid var(--line-strong);
    border-radius: var(--r-surface);
    overflow: hidden;
    background: var(--bg);
    box-shadow: 0 30px 80px -34px rgba(0, 0, 0, 0.95);
    font-family: var(--mono);
    font-size: var(--t-2xs);
  }

  .fleet-bar {
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 8px 12px;
    background: var(--panel);
    border-bottom: 1px solid var(--line);
    color: var(--faint);
  }

  .app {
    font-stretch: var(--w-sub);
    font-weight: 700;
    font-size: var(--t-sm);
    color: var(--text);
  }

  .spacer {
    margin-left: auto;
  }

  .chip {
    border: 1px solid var(--line-strong);
    border-radius: var(--r-control);
    padding: 3px 8px;
    color: var(--dim);
  }

  .fleet-source {
    padding: 6px 12px;
    border-bottom: 1px solid var(--line);
    color: var(--faint);
  }

  table.fleet {
    width: 100%;
    min-width: 660px;
    border-collapse: collapse;
  }

  table.fleet th,
  table.fleet td {
    padding: 7px 12px;
    border-bottom: 1px solid var(--line);
    text-align: right;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  table.fleet th:nth-child(-n + 2),
  table.fleet td:nth-child(-n + 2) {
    text-align: left;
  }

  table.fleet thead th {
    color: var(--faint);
    font-weight: 400;
    border-bottom-color: var(--line-strong);
    letter-spacing: 0.04em;
  }

  .host {
    color: var(--text);
  }

  /* The row that needs attention first is the row that looks like it. */
  tbody tr.urgent {
    background: rgba(255, 107, 107, 0.07);
  }

  .free.tight {
    color: var(--alarm);
    font-weight: 600;
  }

  .free.warm {
    color: var(--hot);
  }

  .growth {
    color: var(--hot);
  }

  .growth.down {
    color: var(--shrink);
  }

  .fills {
    color: var(--text);
  }

  tbody tr.urgent .fills {
    color: var(--alarm);
    font-weight: 600;
  }

  .withheld {
    color: var(--faint);
  }

  svg {
    display: block;
    width: 76px;
    height: 20px;
    margin-left: auto;
  }

  .fleet-foot {
    border-top: 1px solid var(--line);
    padding: 10px 12px;
    background: var(--panel);
    color: var(--faint);
    font-size: var(--t-2xs);
    line-height: 1.5;
  }
</style>
