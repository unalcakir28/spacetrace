---
import { t, type Locale } from "../i18n";
import { localeUrl } from "../i18n/routing";
import { REPO_URL } from "../data/releases";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const dict = t(locale);
---

<footer class="site-foot">
  <div class="wrap">
    <div class="about">
      <p>{dict.footer.licence}</p>
      <p class="faint small">{dict.footer.builtWith}</p>
    </div>
    <nav aria-label={dict.footer.home}>
      <a href={localeUrl(locale, "")}>{dict.footer.home}</a>
      <a href={localeUrl(locale, "download")}>{dict.nav.download}</a>
      <a href={localeUrl(locale, "guide")}>{dict.nav.guide}</a>
      <a href={`${REPO_URL}/releases`}>{dict.footer.allReleases}</a>
      <a href={REPO_URL} translate="no">{dict.nav.github}</a>
    </nav>
  </div>
</footer>

<style>
  .site-foot {
    border-top: 1px solid var(--line);
    padding-block: 34px 48px;
    color: var(--faint);
    font-size: var(--t-sm);
    background: #06080f;
  }

  .site-foot > .wrap {
    display: flex;
    flex-wrap: wrap;
    gap: 22px 40px;
    align-items: flex-start;
  }

  .about {
    max-width: 46ch;
  }

  p {
    margin: 0;
    max-width: none;
  }

  .small {
    font-size: var(--t-xs);
    margin-top: 8px;
  }

  nav {
    display: flex;
    gap: 20px;
    margin-left: auto;
    flex-wrap: wrap;
  }

  a {
    color: var(--dim);
    text-decoration: none;
  }

  a:hover {
    color: #fff;
    text-decoration: underline;
  }
</style>
