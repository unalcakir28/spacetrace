---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import LangRedirect from "../components/LangRedirect.astro";
import LangNotice from "../components/LangNotice.astro";
import { t, LOCALE_TAGS, type Locale } from "../i18n";
import { alternates, localeUrl, asset, type Page } from "../i18n/routing";

interface Props {
  locale: Locale;
  page: Page;
  title: string;
  description: string;
  /** Off for 404, whose path is not one of the translated routes. */
  detectLanguage?: boolean;
}

const {
  locale,
  page,
  title,
  description,
  detectLanguage = true,
} = Astro.props;
const dict = t(locale);
const alts = alternates(page);
const canonical = new URL(localeUrl(locale, page), Astro.site);
---

<!doctype html>
<html lang={LOCALE_TAGS[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Before the stylesheet and the fonts on purpose: an inline script blocks
         parsing, so if this decides to move the reader, nothing was fetched for
         the page they are leaving. -->
    {detectLanguage && <LangRedirect locale={locale} page={page} />}

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <link rel="icon" href={asset("favicon.svg")} type="image/svg+xml" />
    <meta name="theme-color" content="#080b14" />
    <meta name="generator" content={Astro.generator} />

    <!-- Every language of this page, so a search engine serves the right one
         and does not treat the five as duplicates of each other. -->
    {
      alts.map(({ locale: l, url }) => (
        <link
          rel="alternate"
          hreflang={LOCALE_TAGS[l]}
          href={new URL(url, Astro.site).href}
        />
      ))
    }
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(localeUrl("en", page), Astro.site).href}
    />

    <!-- Fonts are on another origin, so the connection is opened before the
         parser reaches the stylesheet that needs it. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Sans+Condensed:wght@600;700&display=swap"
    />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:locale" content={LOCALE_TAGS[locale]} />

    <!-- Inline and first: the reveal styles only apply when JavaScript is
         running, so the class has to land before the first paint or the page
         flashes its content in and then hides it. -->
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
  </head>
  <body>
    <a class="skip" href="#main">{dict.nav.skip}</a>
    {detectLanguage && <LangNotice locale={locale} page={page} />}
    <Header locale={locale} page={page} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} />

    <script>
      // One orchestrated arrival per element, played once. Anything already on
      // screen at load is revealed immediately rather than waiting for a
      // scroll that may never come.
      const targets = [
        ...document.querySelectorAll<HTMLElement>("[data-reveal]"),
      ];
      const reveal = (el: Element) => el.classList.add("armed", "in");

      if (
        targets.length &&
        "IntersectionObserver" in window &&
        !window.matchMedia("(prefers-reduced-motion: reduce)").matches
      ) {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add("in");
              observer.unobserve(entry.target);
            }
          },
          { rootMargin: "0px 0px -8% 0px", threshold: 0.01 },
        );

        for (const el of targets) {
          // Armed one at a time, immediately before being observed, so a
          // failure part way through this loop cannot hide the rest of the
          // page.
          el.classList.add("armed");
          observer.observe(el);
        }

        // Failsafe. If anything is still waiting after three seconds —
        // a browser that never fires the callback, a page that is shorter than
        // its own rootMargin — show it anyway. An unplayed animation is a
        // small loss; unreachable content is not.
        window.setTimeout(() => {
          for (const el of targets) el.classList.add("in");
        }, 3000);
      } else {
        for (const el of targets) reveal(el);
      }
    </script>
  </body>
</html>
